# Server
PORT=3000
NODE_ENV=development
# Placeholder only. Production rejects this value. Set a private 32+ character secret in Render.
JWT_SECRET=replace_with_a_long_random_secret

# SQLite path. Local default is backend/database/splitsmart.db.
# On Render, point this at the persistent disk, for example /var/data/splitsmart.db
DATABASE_PATH=

# PayPal Sandbox only. Live mode is not supported.
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Gemini. The key stays on the server. Finny uses the ledger if Gemini is unavailable.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Elasticsearch Cloud or a self-hosted cluster. Optional.
# Search falls back to SQLite if these are empty.
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=
